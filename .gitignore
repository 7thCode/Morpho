# ── バイナリ / ビルド成果物 ──────────────────────────────
app/bin/
cmd/desktop/build/bin/
cmd/desktop/build/darwin/*.app
/desktop

# ── Wails ───────────────────────────────────────────────
# Trailing "/*" (not "/") so the .gitkeep negation below actually applies —
# a directory-level ignore (trailing "/") stops git from descending into it
# at all, silently defeating any "!" re-include pattern for files inside it.
cmd/desktop/frontend/dist/*
!cmd/desktop/frontend/dist/.gitkeep
cmd/desktop/frontend/node_modules/
cmd/desktop/frontend/package.json.md5

# ── 依存関係 ─────────────────────────────────────────────
app/node_modules/

# ── API キー / シークレット ───────────────────────────────
.env
.env.*
*.key
*.pem
*_secret*
*_api_key*
config.local.*

# ── macOS ────────────────────────────────────────────────
.DS_Store
