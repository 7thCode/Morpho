{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wails: Dev",
      "type": "shell",
      "command": "/Users/oda/go/bin/wails dev",
      "options": {
        "cwd": "${workspaceFolder}/cmd/desktop"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building application",
          "endsPattern": "Using DevServer URL"
        }
      }
    },
    {
      "label": "Wails: Build",
      "type": "shell",
      "command": "/Users/oda/go/bin/wails build",
      "options": {
        "cwd": "${workspaceFolder}/cmd/desktop"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Go: Test All",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$go"
    }
  ]
}
